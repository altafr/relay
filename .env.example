# Create a key at https://openrouter.ai/keys and copy this file to .env.
OPENROUTER_API_KEY=your_openrouter_api_key

# Use openrouter/auto or replace it with any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=openrouter/auto

# Frame uses OpenRouter's dedicated image API for the LinkedIn banner.
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash
